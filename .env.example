# ==============================================================================
# LLM API Keys
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# n8n Configuration
# ==============================================================================
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Tokyo
TZ=Asia/Tokyo

# Basic Auth (Optional: trueに設定する場合はユーザー・パスワードを指定)
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=password123

# ==============================================================================
# Module Settings
# ==============================================================================
# 01_proposal_generator
DEFAULT_SLIDE_TEMPLATE=default_template.pptx

# 02_report_automation
REPORT_OUTPUT_DIR=outputs/reports

# 03_creative_pipeline
CREATIVE_OUTPUT_DIR=outputs/creatives
